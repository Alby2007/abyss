# Copy this file to .env and fill it in. .env is gitignored, never commit it.

# Supabase: Project Settings > API (or "API Keys"). Use the service_role / secret key,
# NOT the anon / publishable one. It stays on the server and is never sent to browsers.
# Leave both blank to store everything in data/db.json instead.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional
# PORT=3000
# ADMIN_KEY=pick-something-long        # turns on /admin for reviewing missed answers
# COOKIE_SECURE=1                      # force Secure cookies (set automatically behind an https proxy)
# TZ_DAILY=Europe/London               # when the daily dive rolls over
